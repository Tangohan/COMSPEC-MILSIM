# Athena — public/.htaccess
# Réécriture vers index.php (front controller)
# Si l’app est servie sous https://athena.ttrd.fr/public/ , définir : RewriteBase /public/

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ——— Anti-miroir (HTTrack et outils similaires) ———
    # Complément Apache ; le middleware PHP AntiScraperMiddleware applique la même logique.
    # Le jeu (clé / User-Agent COMSPECExtension) et les lectures ATAK ne sont pas des miroirs.
    RewriteCond %{HTTP:X-COMSPEC-KEY} ^$
    RewriteCond %{HTTP:Authorization} ^$
    RewriteCond %{HTTP_USER_AGENT} !COMSPECExtension [NC]
    RewriteCond %{REQUEST_URI} !/api/atak/ [NC]
    RewriteCond %{HTTP_USER_AGENT} (HTTrack|Offline[\ ]?Explorer|SiteSucker|WebCopier|WebStripper|WebZIP|WebReaper|WebWhacker|Teleport|Xaldon|EmailWolf|WWWOFFLE|Mass[\ ]Downloader|WebSucker|libwww-perl|Wget/|wget/) [NC]
    RewriteRule .* - [F,L]

    # ——— Redirections 301 (anciennes URLs → URLs propres) ———
    RewriteRule ^index\.html$ / [R=301,L]
    RewriteRule ^dashboard\.html$ /dashboard [R=301,L]
    RewriteRule ^connexion\.html$ /login [R=301,L]
    RewriteRule ^comspec-login\.html$ /login [R=301,L]
    RewriteRule ^personnel-file\.html$ /personnel/me [R=301,L]
    RewriteRule ^orbat\.html$ /orbat [R=301,L]
    RewriteRule ^atak\.html$ /atak [R=301,L]
    RewriteRule ^tacmap\.html$ /tacmap [R=301,L]
    RewriteRule ^enlistment\.html$ /enlistment [R=301,L]
    RewriteRule ^recrutement\.html$ /recrutement [R=301,L]
    RewriteRule ^equipement\.html$ /equipement [R=301,L]
    RewriteRule ^documents\.html$ /documents [R=301,L]
    RewriteRule ^formations\.html$ /formations [R=301,L]
    RewriteRule ^modpacks\.html$ /modpacks [R=301,L]
    RewriteRule ^forum\.html$ /forum [R=301,L]
    RewriteRule ^compte\.html$ /account [R=301,L]
    RewriteRule ^mot-de-passe-oublie\.html$ /forgot-password [R=301,L]

    # Assets / uploads : jamais via index.php (sinon MIME text/html au lieu de text/css, etc.).
    RewriteRule ^(assets|uploads)/ - [L]
    RewriteRule ^(sw\.js|manifest\.webmanifest|favicon\.ico)$ - [L]

    # Fichiers réels uniquement (CSS, JS, images, etc.). Ne pas exclure les répertoires :
    # sinon un dossier physique du même nom qu’un segment d’URL (ex. …/certificates/)
    # court-circuite index.php et les sous-chemins (ex. …/certificates/gabarit) tombent en 404 Apache.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Types MIME explicites (évite un fallback HTML côté hébergeur)
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js .mjs
    AddType application/manifest+json .webmanifest
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType audio/ogg .ogg
    AddType audio/mpeg .mp3
    AddType audio/wav .wav
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>

# ——— Sécurité ———
<IfModule mod_headers.c>
    # Empêcher le sniff MIME
    Header set X-Content-Type-Options "nosniff"
    # Referrer minimal (optionnel)
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Désactiver l’affichage des répertoires
Options -Indexes

# Bloquer l’accès direct à des fichiers sensibles (si jamais exposés)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
