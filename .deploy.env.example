# Copier vers .deploy.env (jamais committer).
# Mode recommandé : git (push GitHub → Action « Deploy VPS » → git pull sur 72.62.22.55).

DEPLOY_ENABLED=1
DEPLOY_MODE=git
DEPLOY_REMOTE=origin
DEPLOY_BRANCH=main
# 1 = le hook tente un git push en fin de tour si la branche est en avance
DEPLOY_AUTO_PUSH=0

