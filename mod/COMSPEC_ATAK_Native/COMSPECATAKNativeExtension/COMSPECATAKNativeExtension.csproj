<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <AssemblyName>COMSPECATAKNativeExtension_x64</AssemblyName>
    <!-- Même code que COMSPEC Link (Extension.cs) : la DLL native suit le numéro de Link, sinon le plancher
         de version d'Athena (« game_min_link_version », SEC-001) refuserait la DLL native corrigée, qui
         annonçait « 1.0.0-native » dans son User-Agent. Le suffixe « -native » distingue les deux builds. -->
    <Version>2.0.102</Version>
    <InformationalVersion>2.0.102-native</InformationalVersion>
    <DefineConstants>$(DefineConstants);COMSPEC_ATAK_NATIVE</DefineConstants>
    <PublishDir>bin\publish\</PublishDir>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('..\..\UptoDate\COMSPECExtension\ClientAttestMaterial.Local.cs')">
    <DefineConstants>$(DefineConstants);COMSPEC_CLIENT_ATTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension.cs" Link="Extension.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_Telemetry.cs" Link="Extension_Telemetry.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_Realism.cs" Link="Extension_Realism.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_SendJournal.cs" Link="Extension_SendJournal.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_SyncStats.cs" Link="Extension_SyncStats.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_DataFlows.cs" Link="Extension_DataFlows.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_RefusalLatch.cs" Link="Extension_RefusalLatch.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_SelfTest.cs" Link="Extension_SelfTest.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_WardrobeCache.cs" Link="Extension_WardrobeCache.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_MedicalRoster.cs" Link="Extension_MedicalRoster.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_ItemIcons.cs" Link="Extension_ItemIcons.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_MapCapture.cs" Link="Extension_MapCapture.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\Extension_MapPhoto.cs" Link="Extension_MapPhoto.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\MapTileImage.cs" Link="MapTileImage.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\GameAuth.cs" Link="GameAuth.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\OfficialClientProof.cs" Link="OfficialClientProof.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\ClientAttestMaterial.Local.cs" Link="ClientAttestMaterial.Local.cs" Condition="Exists('..\..\UptoDate\COMSPECExtension\ClientAttestMaterial.Local.cs')" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\GoogleSlidesDeck.cs" Link="GoogleSlidesDeck.cs" />
    <Compile Include="..\..\UptoDate\COMSPECExtension\BetaNoticeWindow.cs" Link="BetaNoticeWindow.cs" />
  </ItemGroup>
</Project>
