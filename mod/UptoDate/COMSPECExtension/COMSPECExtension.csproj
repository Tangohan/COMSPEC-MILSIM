<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <AssemblyName>COMSPECExtension_x64</AssemblyName>
    <!-- Ne JAMAIS écrire le stub managé (~30 Ko) dans @COMSPECOverwatch :
         seul `dotnet publish` (Native AOT) doit y déposer la vraie DLL (~5 Mo). -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PublishDir>bin\publish\</PublishDir>
    <!-- Réduit les chemins machine dans les artefacts Release (PathMap + CI). -->
    <Version>2.0.110</Version>
    <InformationalVersion>2.0.110</InformationalVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/COMSPECExtension/</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\ClientAttestMaterial.Local.cs')">
    <DefineConstants>$(DefineConstants);COMSPEC_CLIENT_ATTEST</DefineConstants>
  </PropertyGroup>
  <Target Name="WarnMissingClientAttest" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release' AND !Exists('$(MSBuildProjectDirectory)\ClientAttestMaterial.Local.cs')">
    <Warning Text="Publication sans preuve de module officiel : lancez tools/embed-client-attest.php avant de publier, sinon une copie peut encore joindre le poste." />
  </Target>
  <ItemGroup>
    <Compile Remove="Extension_VERSION_FIXED.cs" />
  </ItemGroup>
</Project>
