/vendor/
/.phpunit.cache/
.env
.env.local
.env.*.local
.deploy.env
app/Config/database.local.php
config/cdn_libraries.local.php
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/atak-mod/*
!/storage/atak-mod/.gitkeep
/storage/intel/*
