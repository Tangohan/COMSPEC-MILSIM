# Logos / covers / favicons communauté (uploadés via back-office) : hors Git
/public/assets/img/communities/*
!/public/assets/img/communities/.gitkeep
composer.lock

# --- Exports / dumps de base : jamais dans le dépôt ---
# Contiennent des données de production (e-mails, empreintes de mots de passe, IP,
# jetons). Les migrations versionnées, elles, restent suivies.
*.sql
!migrations/**/*.sql
!bootstrap/**/*.sql
!docs/**/*.sql
*.sql.gz
*.sql.zip
*.dump

.idea/
.vscode/
.cursor/
.worktrees/
*.log
node_modules/
ressources/

# Archives locales du mod — le site VPS n’en a pas besoin (sparse-checkout).
# L’historique GitHub les conserve tant qu’on ne fait pas de filter-repo.
mod/Ancienne version de tout/
mod/_local_pre_pr150_backup/

# Copie locale TCPDF : ne pas versionner un dépôt Git imbriqué
tcpdf/.git/

# --- Mod Arma : artefacts de build / debug (ne jamais shipper sur Workshop) ---
# Dossier de travail actif : mod/UptoDate/ (voir mod/UptoDate/README.md).
# mod/Ancienne version de tout/ est une archive figée, non reconstruite.
mod/UptoDate/@COMSPECOverwatch/**/*.pdb
mod/UptoDate/@COMSPECOverwatch/net8.0/
mod/UptoDate/@COMSPECOverwatch/COMSPECExtension_x64.pdb
mod/UptoDate/COMSPECExtension/bin/
mod/UptoDate/COMSPECExtension/obj/
mod/UptoDate/COMSPECExtension/**/*.pdb
mod/UptoDate/build_log.txt
mod/UptoDate/build_tmp_out.txt
# Staging Workshop régénéré par mod/UptoDate/workshop-pack.ps1
mod/UptoDate/publisher/
mod/UptoDate/COMSPECOverwatch-workshop.zip

# Staging Workshop SSE (mod/@COMSPEC_SSE/workshop-pack.ps1)
mod/@COMSPEC_SSE/build_log.txt
mod/@COMSPEC_SSE/_build_tmp/
mod/publisher/
mod/COMSPEC_SSE-workshop.zip

tools/i18n/site_missing.tsv
mod/COMSPEC_ATAK_Native/tools/i18n/missing_connect.tsv
mod/COMSPEC_ATAK_Native/tools/__pycache__/
/storage/i18n/*

# Caches Python (jamais versionnés)
__pycache__/
*.pyc

# --- Sorties de build du mod Arma jamais suivies (audit DEAD-001..004, DEAD-010) ---
# mod/UptoDate/@COMSPECOverwatch/ (PBO, DLL, logos, mod.cpp) RESTE suivi : la procédure de sortie
# recompile puis committe ces fichiers, et un « git rm --cached » ferait refuser le prochain
# « git pull » d'un poste qui vient de les reconstruire (revue E du lot nettoyage).

# Instantanés et packs d'archive : à publier en release GitHub, pas dans l'arbre
mod/UptoDate/StableBeta/
mod/UptoDate/@COMSPECOverwatch_StableBeta/
mod/UptoDate/@COMSPECOverwatch.zip

# Dossier de sonde / exploration de mods tiers
mod/UptoDate/_tmp_marker_probe/

# Sorties dotnet des deux projets d'extension, et d'eux seuls : un « bin/ » plus large
# masquerait sans prévenir un futur dossier d'outils ou d'assets (server/node_modules/*/bin
# contient déjà des fichiers suivis)
mod/UptoDate/COMSPECExtension/bin/
mod/UptoDate/COMSPECExtension/obj/
mod/COMSPEC_ATAK_Native/COMSPECATAKNativeExtension/bin/
mod/COMSPEC_ATAK_Native/COMSPECATAKNativeExtension/obj/

# Journaux de compilation et comptes rendus d'outils
mod/UptoDate/build_log.txt
mod/UptoDate/build_tmp_out.txt
mod/UptoDate/build_*.log
*.log.err
mod/UptoDate/tools/metis-paa-to-png-last-run.txt
mod/UptoDate/tools/**/_conversion_log.txt
