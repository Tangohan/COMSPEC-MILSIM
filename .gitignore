composer.lock

# --- Exports / dumps de base : jamais dans le dépôt ---
# Contiennent des données de production (e-mails, empreintes de mots de passe, IP,
# jetons). Les migrations versionnées, elles, restent suivies.
*.sql
!migrations/**/*.sql
!bootstrap/**/*.sql
!docs/**/*.sql
*.sql.gz
*.sql.zip
*.dump

.idea/
.vscode/
.cursor/
.worktrees/
*.log
node_modules/
ressources/

# Archives locales du mod — le site VPS n’en a pas besoin (sparse-checkout).
# L’historique GitHub les conserve tant qu’on ne fait pas de filter-repo.
mod/Ancienne version de tout/
mod/_local_pre_pr150_backup/

# Copie locale TCPDF : ne pas versionner un dépôt Git imbriqué
tcpdf/.git/

# --- Mod Arma : artefacts de build / debug (ne jamais shipper sur Workshop) ---
# Dossier de travail actif : mod/UptoDate/ (voir mod/UptoDate/README.md).
# mod/Ancienne version de tout/ est une archive figée, non reconstruite.
mod/UptoDate/@COMSPECOverwatch/**/*.pdb
mod/UptoDate/@COMSPECOverwatch/net8.0/
mod/UptoDate/@COMSPECOverwatch/COMSPECExtension_x64.pdb
mod/UptoDate/COMSPECExtension/bin/
mod/UptoDate/COMSPECExtension/obj/
mod/UptoDate/COMSPECExtension/**/*.pdb
mod/UptoDate/build_log.txt
mod/UptoDate/build_tmp_out.txt
# Staging Workshop régénéré par mod/UptoDate/workshop-pack.ps1
mod/UptoDate/publisher/
mod/UptoDate/COMSPECOverwatch-workshop.zip

# Staging Workshop SSE (mod/@COMSPEC_SSE/workshop-pack.ps1)
mod/@COMSPEC_SSE/build_log.txt
mod/@COMSPEC_SSE/_build_tmp/
mod/publisher/
mod/COMSPEC_SSE-workshop.zip

