# Athena — racine du domaine (public_html / DocumentRoot = dépôt)
# Sur le VPS nginx, DocumentRoot pointe déjà vers public/ : ce fichier n’est pas lu.
# Sur Hostinger (DocumentRoot = racine du dépôt), pont vers l’URL canonique /public/…

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Connexion téléphone ATAK → /public/connect
    RewriteRule ^connect/?$ /public/connect [R=302,L,QSA]
    RewriteRule ^connect/(.*)$ /public/connect/$1 [R=302,L,QSA]

    # Carte ATAK → /public/atak (URL canonique ; ne pas réécrire vers un dossier filesystem)
    RewriteRule ^atak/?$ /public/atak [R=302,L,QSA]
    RewriteRule ^atak/(.*)$ /public/atak/$1 [R=302,L,QSA]
</IfModule>
