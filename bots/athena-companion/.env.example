DISCORD_TOKEN=replace-with-the-official-bot-token
ATHENA_COMPANION_API_KEY=replace-with-a-random-key-of-at-least-32-characters
# Use exactly the public site base URL, including /public if applicable.
ATHENA_SITE_URL=https://athena-comspec.eu/public
ATHENA_COMPANION_STATE=/var/lib/athena-discord-bot/state.sqlite3
# Facultatif (voir docs/discord-bot-vps.md) :
# ATHENA_COMPANION_HEARTBEAT=/run/athena-discord-bot/heartbeat
# ATHENA_COMPANION_HEALTH_PORT=8765
# ATHENA_COMPANION_MEMBERS_INTENT=1
