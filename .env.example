# ===========================================
# Athena / COMSPEC MILSIM — Configuration
# Copier vers .env et renseigner les valeurs.
# ===========================================

# Application
APP_NAME="Athena"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://athena.ttrd.fr
# Chemin de base si l’app est servie dans un sous-dossier.
# VPS Nginx (root = …/public, site à la racine) : laisser VIDE.
#   Les mods Workshop appellent encore https://athena.ttrd.fr/public/… — Nginx
#   réécrit ce préfixe en interne (docs/nginx.example.conf). Ne pas remettre
#   APP_BASE_PATH=/public sur le VPS : les liens générés redeviendraient
#   …/public/… alors que la racine / répond déjà, et un alias Nginx mal posé
#   (SCRIPT_NAME=/public/index.php) recréerait /public/public.
# Hostinger historique uniquement : APP_BASE_PATH=/public
APP_BASE_PATH=
APP_LOCALE=fr
APP_TIMEZONE=Europe/Paris
# Version affichée si storage/app_version.json est absent (le fichier de version prime après déploiement)
# APP_VERSION=1.0.0

# Signature HMAC des packages de mise à jour (recommandé en production).
# Si renseigné, chaque manifest.json doit contenir "signature" = HMAC-SHA256(version|minimum_version|checksum, secret).
# UPDATE_PACKAGE_HMAC_SECRET=

# Mentions légales & contact public (recommandé en production)
# APP_PUBLISHER_NAME="Votre raison sociale"
# APP_PUBLISHER_LEGAL_FORM="SAS au capital de …"
# APP_PUBLISHER_ADDRESS="Adresse complète\nCode postal Ville"
# APP_PUBLISHER_IDENTIFIER="SIREN ou SIRET"
# APP_PUBLISHER_RCS="RCS …"
# APP_PUBLISHER_VAT_ID="FR…"
# APP_PUBLISHER_PUBLICATION_DIRECTOR="Prénom Nom"
# APP_PUBLISHER_CONTACT_EMAIL=contact@example.com
# Boîte qui reçoit le formulaire « Exercer vos droits » (RGPD). Si vide : repli sur APP_PUBLISHER_CONTACT_EMAIL.
# PRIVACY_REQUEST_EMAIL=privacy@example.com
# APP_HOSTING_NAME="Nom de l’hébergeur"
# APP_HOSTING_ADDRESS="Adresse de l’hébergeur"
# APP_HOSTING_PHONE=

# Slugs dont la fiche /c/{slug} est traitée comme « portail plateforme » (ton allégé) si public_audience n’est pas défini en base — ex. communauté système Athena
# PLATFORM_PUBLIC_TENANT_SLUGS=athena-sys
# Optionnel : surcharge le quota mensuel de créations d’événements (plan gratuit free). Entier > 0. Sinon = valeur limits_json en base.
# FREE_EVENTS_PER_MONTH=5

# Base de données MySQL (obligatoire pour setup-database / migrations)
# Hostinger / PHP-FPM : utiliser 127.0.0.1 (TCP). « localhost » force souvent un socket
# Unix → SQLSTATE[HY000] [2002] Operation not permitted.
DB_HOST=127.0.0.1
DB_NAME=athena
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Migrations (setup-database) : assigner « Parcours portail » à tous les comptes actifs — 1/true/on uniquement si besoin (charge DB)
# TRAINING_ONBOARDING_ASSIGN_ALL=

# Session
# Durée de session en minutes (300 = 5 h). Appliquée au cookie et aux données serveur.
SESSION_LIFETIME=1440
# Cookie de session envoyé uniquement en HTTPS. Laisser vide = déduit de APP_ENV
# (activé en production). Ne passer à false qu'en développement local sans TLS.
SESSION_SECURE_COOKIE=true
# Chemin absolu des fichiers de session. Sur Hostinger (déploiement FTP), le mettre
# HORS de public_html pour éviter toute déconnexion lors d’un sync Git→FTP, ex. :
# SESSION_SAVE_PATH=/home/u416380327/tmp/athena_sessions
# Laisser vide = storage/sessions (déjà exclu du workflow FTP).
# SESSION_SAVE_PATH=

# Sécurité
JWT_SECRET=

# Erreurs serveur : rapport détaillé par e-mail (stack, utilisateur, requête) — réservé exploitation ; le client API ne reçoit qu’un message générique
# ERROR_ALERT_ENABLED=false pour désactiver
ERROR_ALERT_ENABLED=true
# Obligatoire pour recevoir les mails d’incident (sinon seulement storage/logs/error-alerts.log).
# La même adresse reçoit aussi une alerte lorsqu’une nouvelle communauté est créée.
ERROR_ALERT_EMAIL=
# Anti-tempête : même erreur + même IP
ERROR_ALERT_COOLDOWN_SECONDS=120
ERROR_ALERT_MAX_PER_HOUR=30
# Les alertes error_alert partent en immédiat (ignorent MAIL_QUEUE).
# Hors production : exiger X_COMSPEC_KEY / Bearer sur les API tactiques comme en prod (préproduction sécurisée)
TACTICAL_API_STRICT=false

# Maintenance (défaut: désactivé)
MAINTENANCE_ENABLED=false
MAINTENANCE_MESSAGE="Maintenance en cours. Merci de réessayer dans quelques minutes."
# IPs autorisées à accéder pendant la maintenance (séparées par des virgules, vide = aucune)
MAINTENANCE_ALLOWED_IPS=
# Token pour activer/désactiver la maintenance via script web (optionnel)
MAINTENANCE_TOKEN=

# Portail d’engagement démo (NDA) — désactivé par défaut
# Dès le 1er hit, l’IP est enregistrée ; code à saisir sous DEMO_NDA_GATE_CLAIM_MINUTES,
# puis accès limité à DEMO_NDA_GATE_SESSION_HOURS après validation.
# Les APIs machine (/api/atak/*, préfixes tactiques du mod) restent accessibles sans session démo.
# DEMO_NDA_GATE_ACCESS_CODE : code à communiquer (prioritaire). Exemple : A7K9-M2XP
# DEMO_NDA_GATE_BYPASS_IPS : vos IPs exemptées (virgules) — recommandé pour garder l’admin sans passer par le portail.
DEMO_NDA_GATE_ENABLED=false
DEMO_NDA_GATE_CLAIM_MINUTES=25
DEMO_NDA_GATE_SESSION_HOURS=1
# Rétrocompat : si SESSION_HOURS est vide, TTL_HOURS sert de durée d’accès.
DEMO_NDA_GATE_TTL_HOURS=1
DEMO_NDA_GATE_ACCESS_CODE=
DEMO_NDA_GATE_BYPASS_IPS=
# Afficher l’IP observée sur la page d’engagement (utile pour renseigner BYPASS_IPS)
DEMO_NDA_GATE_SHOW_IP=false
# Clé secrète de déblocage : https://ton-site/?demo_nda_unlock=CETTE_CLE (réouvre l’IP courante)
DEMO_NDA_GATE_UNLOCK_KEY=
# Boîte qui reçoit le questionnaire de retour démo. Si vide : APP_PUBLISHER_CONTACT_EMAIL puis PRIVACY_REQUEST_EMAIL.
# DEMO_NDA_FEEDBACK_EMAIL=contact@example.com

# Tâches automatiques (cron) — clé pour l’appel distant GET/POST /cron/run?key=…
# Laissez vide pour désactiver l’appel HTTP (la commande CLI reste utilisable).
# CRON_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Modération contenus (ClamAV + heuristiques locales)
# MODERATION_ENABLED=true
# MODERATION_RULESET_VERSION=2026.04.05
# MODERATION_THRESHOLD_LOW=30
# MODERATION_THRESHOLD_HIGH=75
# MODERATION_CLAMAV_BIN=
# MODERATION_QUARANTINE_DAYS=14
# Compte technique par tenant : system.moderation@internal.local (créé par migrations, non connectable)

# Courriel transactionnel (PHPMailer — config/email.php)
# file = écriture .eml dans storage/mail-outbox (dev) ; smtp | sendgrid | mailgun | ses = SMTP (hôtes par défaut si MAIL_HOST vide pour sendgrid/mailgun/ses)
# MAIL_QUEUE=true : les envois sont mis en file (table async_jobs) ; un cron doit exécuter régulièrement : php worker-jobs.php 50
# Sans worker, les messages restent en attente et ne partent pas.
MAIL_MAILER=file
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Athena
# SMTP « Could not authenticate » : mot de passe boîte = celui du panneau (hPanel, etc.), pas le mot de passe du compte hébergeur.
# Mettre MAIL_USERNAME = adresse e-mail complète. Guillemets si le mot de passe contient # ou espaces : MAIL_PASSWORD="..."
# MAIL_REPLY_TO=
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# tls = STARTTLS (souvent port 587) | ssl = SMTPS implicite (souvent port 465) | vide = sans chiffrement (rare)
# MAIL_ENCRYPTION=tls
# Si erreur « STARTTLS command failed » (ex. Hostinger) : MAIL_PORT=465 + MAIL_ENCRYPTION=ssl. Si ça échoue encore : pare-feu sortant 465/587, ou test 587+tls.
# Vérifiez que le serveur PHP peut sortir en TCP 587/465 (pare-feu hébergeur / sortie bloquée).
# MAIL_SMTP_TIMEOUT=30
# Dépannage certificat uniquement (réduire la sécurité — pas en prod si évitable) :
# MAIL_SSL_VERIFY_PEER=false
# AWS_SES_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# MAIL_LOGIN_BRUTE_THRESHOLD=8
# MAIL_LOGIN_BRUTE_WINDOW=60
# SECURITY_ALERT_EMAILS=
# MAIL_GEOIP_ENABLED=true

# Logs
LOG_CHANNEL=file
LOG_LEVEL=warning
LOG_PATH=storage/logs

# ATAK / Node (optionnel, pour l’interface carte temps réel)
NODE_ATAK_URL=http://localhost:3001
# Tuiles de carte Arma (motif {z}/{x}/{y}.png). Défaut GitHub Pages (CORS OK).
# Si vous avez accès au CDN OVH plan-ops : https://mapsdata.plan-ops.fr
ATAK_MAP_TILES_CDN=https://jetelain.github.io/Arma3Map
# Icônes marqueurs Arma (PAA→PNG). Défaut : /assets/markers/arma sous le portail.
# Ex. CDN : https://cdn.example.com/arma-markers
# ATAK_MARKER_ICONS_CDN=

# API tactiques (ATAK, markers, C2, etc.) — obligatoire si APP_ENV=production ou si TACTICAL_API_STRICT=true
# En-têtes acceptés : X_COMSPEC_KEY, X_ATAK_TOKEN ou Authorization: Bearer <valeur>
# Exceptions sans clé : GET /api/atak/ping, GET /api/atak/whoami
X_COMSPEC_KEY=

# Steam Web API (import photo / nom depuis le profil public — clé sur https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=

# Formations : afficher les modules legacy_training_* dans le catalogue (true par défaut)
TRAINING_LEGACY_ENABLED=true

# Stripe (facturation communautés — webhooks Checkout / Billing) — secours si PayPal absent
# Secret du endpoint webhook (dashboard Stripe → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=
# Clés API (Checkout côté serveur, portail client) — à renseigner si implémenté
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# PayPal (facturation prioritaire — Billing Subscriptions + Orders)
# Mode : sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Identifiant du webhook (dashboard PayPal → Webhooks) — URL : /api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# Nom affiché sur les pages de paiement PayPal
PAYPAL_BRAND_NAME=Athena
# Fournisseur préféré : paypal | stripe | auto (défaut auto = PayPal si configuré)
BILLING_PROVIDER=auto

# ---------------------------------------------------------------------------
# Clés souvent présentes sur les déploiements existants (non toutes lues par le cœur minimal)
# ---------------------------------------------------------------------------
# APP_KEY=
# APP_FALLBACK_LOCALE=fr
# APP_CSP=
# Si APP_CSP est défini en prod : autoriser 'self' suffit pour Three.js et le lecteur
# PDF (vendored sous public/assets/vendor/). Sinon ajouter https://cdn.jsdelivr.net au script-src.
# APP_FORCE_HTTPS=true
# DB_PORT=3306
# DB_DIALECT=mysql
# DB_COLLATION=utf8mb4_unicode_ci
# SESSION_DRIVER=database
# SESSION_TABLE=sessions
# SESSION_PATH=/
# SESSION_DOMAIN=
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=Lax
# CSRF_TOKEN_NAME=_token
# COOKIE_PREFIX=athena_
# COOKIE_SECURE=true
# MAIL_FROM=
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_SECRET=
# JWT_TTL=900
# JWT_REFRESH_TTL=3600
# NODE_ATAK_TIMEOUT=10
# NODE_SHARED_SECRET=
# ATAK_DEFAULT_TENANT_ID=
# CACHE_DRIVER=file
# CACHE_PATH=storage/cache
# QUEUE_DRIVER=sync
# UPLOAD_MAX_FILESIZE=10485760
# UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp,zip
# FEATURE_SCORM_ENABLED=true
# FEATURE_TACTICAL_ENABLED=true

# Coopération inter-unités — visioconférence (Jitsi en iframe sur la fiche coopération)
# Domaine du serveur Jitsi (ex. meet.jit.si ou votre instance). Vide = pas d’iframe (le bloc reste masqué si le domaine est vide).
# JITSI_DOMAIN=meet.jit.si
# JITSI_COOP_ENABLED=true
# Enregistrement : nécessite en général une instance Jitsi auto-hébergée avec module d’enregistrement (ex. Jibri), non fourni par l’application seule.

# Accès web à run-migrations.php (surcharge le mot de passe configuré dans config/migrations_web.php)
# MIGRATIONS_WEB_PASSWORD=
