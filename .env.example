# ===========================================
# Athena / COMSPEC MILSIM — Configuration
# Copier vers .env et renseigner les valeurs.
# ===========================================

# Application
APP_NAME="Athena"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://athena.ttrd.fr
# Chemin de base si l’app est servie dans un sous-dossier (ex. /public pour https://athena.ttrd.fr/public/)
APP_BASE_PATH=/public
APP_LOCALE=fr
APP_TIMEZONE=Europe/Paris
# Optionnel : surcharge le quota mensuel de créations d’événements (plan gratuit free). Entier > 0. Sinon = valeur limits_json en base.
# FREE_EVENTS_PER_MONTH=5

# Base de données MySQL (obligatoire pour setup-database / migrations)
DB_HOST=127.0.0.1
DB_NAME=athena
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# Sécurité
JWT_SECRET=

# Maintenance (défaut: désactivé)
MAINTENANCE_ENABLED=false
MAINTENANCE_MESSAGE="Maintenance en cours. Merci de réessayer dans quelques minutes."
# IPs autorisées à accéder pendant la maintenance (séparées par des virgules, vide = aucune)
MAINTENANCE_ALLOWED_IPS=
# Token pour activer/désactiver la maintenance via script web (optionnel)
MAINTENANCE_TOKEN=

# Modération contenus (ClamAV + heuristiques locales)
# MODERATION_ENABLED=true
# MODERATION_RULESET_VERSION=2026.04.05
# MODERATION_THRESHOLD_LOW=30
# MODERATION_THRESHOLD_HIGH=75
# MODERATION_CLAMAV_BIN=
# MODERATION_QUARANTINE_DAYS=14
# Compte technique par tenant : system.moderation@internal.local (créé par migrations, non connectable)

# Courriel transactionnel (PHPMailer — config/email.php)
# file = écriture .eml dans storage/mail-outbox (dev) ; smtp | sendgrid | mailgun | ses = SMTP (hôtes par défaut si MAIL_HOST vide pour sendgrid/mailgun/ses)
MAIL_MAILER=file
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Athena
# MAIL_REPLY_TO=
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# AWS_SES_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# MAIL_LOGIN_BRUTE_THRESHOLD=8
# MAIL_LOGIN_BRUTE_WINDOW=60
# SECURITY_ALERT_EMAILS=
# MAIL_GEOIP_ENABLED=true

# Logs
LOG_CHANNEL=file
LOG_LEVEL=warning
LOG_PATH=storage/logs

# ATAK / Node (optionnel, pour l’interface carte temps réel)
NODE_ATAK_URL=http://localhost:3001

# Stripe (facturation communautés — webhooks Checkout / Billing)
# Secret du endpoint webhook (dashboard Stripe → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=
# Clés API (Checkout côté serveur, portail client) — à renseigner si implémenté
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
