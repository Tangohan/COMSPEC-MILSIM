{
    "name": "athena/comspec-milsim",
    "description": "Athena — SaaS RH tactique MILSIM Arma 3",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.15",
        "dompdf/dompdf": "^3.0",
        "endroid/qr-code": "^5.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"file_exists('config/phinx.php') || copy('config/phinx.php.dist', 'config/phinx.php');\""
        ]
    }
}
