{
    "name": "athena/comspec-milsim",
    "description": "Athena — SaaS RH tactique MILSIM Arma 3",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-zlib": "*",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^3.0",
        "endroid/qr-code": "^5.0",
        "phpmailer/phpmailer": "^6.9",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^7.0"
    },
    "suggest": {
        "ext-gd": "Recommandé pour les QR PNG via endroid/qr-code (PngWriter) et phpqrcode. Sans GD, Athena bascule sur PNG zlib / SVG (phpqrcode)."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpstan:baseline": "phpstan analyse --memory-limit=1G --generate-baseline=phpstan-baseline.neon"
    }
}
