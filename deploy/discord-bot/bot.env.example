# Modèle de /etc/athena-discord-bot/bot.env (propriétaire root, groupe athena-bot, droits 0640). Ne jamais le mettre dans le dépôt.
# install.sh le copie au premier passage ; remplacez ensuite chaque valeur « à remplir ».

# Jeton du bot : portail des développeurs Discord > Bot > Reset Token. Il ne sert qu'à ce service.
DISCORD_TOKEN=à remplir

# Clé de l'API privée du bot : au moins 32 caractères au hasard (par exemple: openssl rand -hex 32).
# La même valeur se saisit dans Administration > Intégrations de la plateforme > ATHENA Companion.
ATHENA_COMPANION_API_KEY=à remplir

# Adresse publique du site, en HTTPS, avec /public si le site l'utilise.
ATHENA_SITE_URL=https://athena-comspec.eu

# Facultatif : accueil des nouveaux arrivants. Active l'intent privilégié « Server Members » (à cocher aussi dans le portail Discord).
# ATHENA_COMPANION_MEMBERS_INTENT=1
