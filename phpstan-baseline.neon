parameters:
	ignoreErrors:
		-
			message: '#^Undefined variable\: \$accessEvents$#'
			identifier: variable.undefined
			count: 1
			path: app/Controllers/Admin/AdminDocumentsController.php

		-
			message: '#^Undefined variable\: \$accessSessions$#'
			identifier: variable.undefined
			count: 1
			path: app/Controllers/Admin/AdminDocumentsController.php

		-
			message: '#^Undefined variable\: \$ageDays$#'
			identifier: variable.undefined
			count: 2
			path: app/Repositories/AtakAdvancedIntelligenceRepository.php

		-
			message: '#^Undefined variable\: \$ageHours$#'
			identifier: variable.undefined
			count: 1
			path: app/Repositories/AtakAdvancedIntelligenceRepository.php

		-
			message: '#^Unknown parameter \$data in call to Endroid\\QrCode\\Builder\\Builder constructor\.$#'
			identifier: argument.unknown
			count: 1
			path: app/Services/Qr/QrPngGenerator.php

		-
			message: '#^Unknown parameter \$margin in call to Endroid\\QrCode\\Builder\\Builder constructor\.$#'
			identifier: argument.unknown
			count: 1
			path: app/Services/Qr/QrPngGenerator.php

		-
			message: '#^Unknown parameter \$size in call to Endroid\\QrCode\\Builder\\Builder constructor\.$#'
			identifier: argument.unknown
			count: 1
			path: app/Services/Qr/QrPngGenerator.php

		-
			message: '#^Unknown parameter \$writer in call to Endroid\\QrCode\\Builder\\Builder constructor\.$#'
			identifier: argument.unknown
			count: 1
			path: app/Services/Qr/QrPngGenerator.php

		-
			message: '#^Caught class App\\Services\\Rbac\\PDOException not found\.$#'
			identifier: class.notFound
			count: 1
			path: app/Services/Rbac/RoleDefinitionCatalog.php

		-
			message: '#^Regex pattern is invalid\: Unknown modifier ''\+'' in pattern\: \#\\A/\[a\-zA\-Z0\-9/_\\\-\.\?\=&%%\#\+\:~\]\*\\z\#$#'
			identifier: regexp.pattern
			count: 1
			path: app/Support/training_canvas.php
